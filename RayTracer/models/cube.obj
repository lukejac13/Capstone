# Simple cube OBJ file
# Vertices (8 corners of a cube)
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# Faces (each face as two triangles)
# Front face (z = -1)
f 1 2 3
f 1 3 4

# Back face (z = 1)
f 5 8 7
f 5 7 6

# Left face (x = -1)
f 1 4 8
f 1 8 5

# Right face (x = 1)
f 2 6 7
f 2 7 3

# Top face (y = 1)
f 4 3 7
f 4 7 8

# Bottom face (y = -1)
f 1 5 6
f 1 6 2
